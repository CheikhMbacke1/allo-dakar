# Copier ce fichier en .env dans apps/api/ (jamais commiter le vrai .env)

# --- Base de données ---
# En local (docker-compose) :
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allo_dakar?schema=public"
# En production (Neon) : récupérer la "connection string" pooled dans le
# dashboard Neon (Settings > Connection Details), format :
# DATABASE_URL="postgresql://<user>:<password>@<host>/<db>?sslmode=require"

# --- Auth ---
JWT_SECRET="change-moi-en-production-avec-une-valeur-aleatoire-longue"

# --- Serveur ---
PORT=3001

# --- SMS (phase 2 : brancher un vrai fournisseur) ---
# SMS_PROVIDER_API_KEY=

# --- Push (phase 4 : Expo Push Service) ---
# EXPO_PUSH_ACCESS_TOKEN=
